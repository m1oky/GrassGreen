!GrassGreen!
!fsys!

int main() {
    gout << "=== ТЕСТИРОВАНИЕ БИБЛИОТЕКИ !fsys! ===" << endl;

    take folder = "test_dir";
    take ok = fs_mkdir(folder);
    gout << "Создание папки '" << folder << "': " << ok << endl;

    take check_dir = fs_is_dir(folder);
    gout << "Это папка (1 = да): " << check_dir << endl;

    take src_file = "bin/grassc.exe";
    take f_size = fs_size(src_file);
    gout << "Размер файла " << src_file << ": " << f_size << " байт" << endl;

    gout << "Список файлов в папке bin:" << endl;
    take list_out = fs_list("bin");
    gout << list_out << endl;

    return 0;
}