!GrassGreen!
!sys!

int main() {
    gout << "=== [GrassGreen v3.4.0 System Diagnostics] ===" << endl;
    gout << "Имя ПК: " << pc_name() << " | Пользователь: " << user_name() << endl;
    gout << "Разрешение экрана: " << screen_w() << "x" << screen_h() << endl;
    gout << "Потоков CPU: " << cpu_cores() << endl;
    gout << "ОЗУ: свободно " << ram_free_mb() << " MB из " << ram_total_mb() << " MB" << endl;
    gout << "Аптайм Windows: " << uptime_sec() << " сек" << endl;

    // Тест буфера обмена (Clipboard)
    clip_set("GrassGreen Engine 2026");
    gout << "Скопировано в буфер обмена: " << clip_get() << endl;

    return 0;
}