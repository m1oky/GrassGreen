!GrassGreen!

// =============================================================================
// GrassGreen Multifile Application: Stress Test Driver (main.grass)
// Imports math_utils.grass and engine.grass.
// Executes 10,000 simulation iterations verifying:
// - 4x4 matrix calculations and Taylor trigonometry
// - Heavy XMM register pipeline and deep recursion stack spilling
// - OOP class hierarchy with polymorphic virtual method dispatch
// - Manual dynamic memory alloc/free and RAII cleanup
// =============================================================================

import "math_utils.grass";
import "engine.grass";

int main() {
    gout << "========================================================" << endl;
    gout << "  GRASSGREEN 4.1 MULTIFILE APP: 10,000 ITERATION STRESS TEST" << endl;
    gout << "========================================================" << endl;

    // 1. Matrix 4x4 Initialization
    Mat4 mat_a;
    Mat4 mat_b;
    Mat4 mat_out;

    mat4_set_identity(mat_a);
    mat4_set_identity(mat_b);
    mat4_set_identity(mat_out);

    mat_a.m00 = 2.0; mat_a.m11 = 2.0; mat_a.m22 = 2.0;
    mat_b.m03 = 5.0; mat_b.m13 = 10.0; mat_b.m23 = 15.0;

    mat4_multiply(mat_a, mat_b, mat_out);
    gout << "[PASS] 4x4 Matrix multiplication initialized successfully." << endl;

    // 2. Entity Lifecycle & Component Instantiation
    Entity actor;
    actor.create(42, 1000);
    gout << "[PASS] Entity created: id=" << actor.id << ", hp=" << actor.health << endl;

    // 3. 10,000 Simulation Iterations Loop
    gout << "Running 10,000 simulation cycles..." << endl;
    float sim_dt = 0.016;
    float accumulated_energy = 0.0;

    for (take step = 0; step < 10000; step++) {
        // Entity logic update (virtual dispatch to TransformComponent and PhysicsComponent)
        actor.update(sim_dt);

        // Heavy floating point calculations exercising XMM registers
        float angle = math_deg_to_rad(step % 360);
        float s = math_sin(angle);
        float c = math_cos(angle);

        float pipe_res = xmm_heavy_pipeline(s, c, 1.5, 2.5, 3.5, 4.5, 5.5, 6.5);
        accumulated_energy = accumulated_energy + pipe_res * 0.0001;

        if (step % 2000 == 0) {
            actor.take_damage(50);
        }
    }

    gout << "[PASS] 10,000 iterations completed. Accumulated energy: " << accumulated_energy << endl;
    gout << "[PASS] Entity state after sim: hp=" << actor.health << ", active=" << actor.active << endl;

    // 4. Deep Recursion Test: XMM Register Stack Spilling Verification
    gout << "Executing deep recursive XMM register preservation (depth 12)..." << endl;
    float rec_result = recursive_xmm_spill(1.5707963, 12);
    gout << "[PASS] Deep recursive evaluation result: " << rec_result << endl;

    // 5. RAII and Manual Dynamic Allocation Cleanup
    actor.destroy();
    gout << "[PASS] Entity destroyed: active=" << actor.active << ", buffers freed via free()." << endl;

    gout << "========================================================" << endl;
    gout << "  ALL MULTIFILE APP STRESS CHECKS PASSED (100% OK)" << endl;
    gout << "========================================================" << endl;
    return 0;
}
