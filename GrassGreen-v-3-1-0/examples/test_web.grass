!GREEN_WWW1!
!GrassWeb!

// ====================================================
// 1. ГЛАВНАЯ ПАНЕЛЬ АВТОРИЗАЦИИ (GLASS + NEON)
// ====================================================
glass(16, 0.08)
neon(#00ffcc)
box-start

    icon(bolt)
    color(#00ffcc)
    thick()
    G5 GrassGreen Web OS v3.0

    <name>/status_txt
    color(#8e99a8)
    G2 Введите секретный код администратора (1234):

    <name>/code_input
    neon(#00ffcc)
    round-ob(10)
    size(360, 48)
    enter = Введите пароль доступа...

    row-start
        <name>/btn_login
        icon(key)
        grad(#00ffcc, #0088ff)
        color(#0b0b0f)
        thick()
        round-ob(10)
        button = Авторизоваться

        <name>/btn_clicker
        icon(fire)
        neon(#ff007f)
        round-ob(10)
        button = Кликов: 0
    row-end

    <name>/secret_box
    hide()
    color(#00ff88)
    thick()
    G3 ✔️ Доступ получен! Виртуальная машина переведена в режим Host.

box-end

// ====================================================
// 2. КАРТОЧКА СИСТЕМНЫХ НАСТРОЕК (GSE CONFIG)
// ====================================================
glass(14, 0.05)
box-start

    icon(settings)
    color(#ffffff)
    thick()
    G3 Конфигурация GSE & Runtime

    <name>/chk_turbo
    neon(#00ffcc)
    checkbox = Включить стабилизатор FPS (sys_fps_stabilizer)

    <name>/chk_gpu
    checkbox = Принудительный рендеринг на встроенной графике UHD

    <name>/lbl_ram
    color(#aaaaaa)
    G1 Выделение оперативной памяти (MB):

    <name>/ram_slider
    neon(#a200ff)
    size(380, 20)
    slider(1024, 8192, 4096)

    <name>/drop_env
    neon(#0088ff)
    round-ob(8)
    drop-list(fabric-1.20.1, forge-1.20.1, terraria-v1.4.4, native-cpp)

    row-start
        <name>/btn_save
        icon(check)
        grad(#a200ff, #00ffcc)
        color(#ffffff)
        thick()
        round-ob(10)
        button = Сохранить в память браузера
    row-end

box-end

// ====================================================
// 3. БЛОК ЛОГИКИ И СОБЫТИЙ (JAVASCRIPT)
// ====================================================
script-start
    var(clicks = 0)

    // Обработка кнопки-кликера
    on-click(btn_clicker)
        add-var(clicks, 1)
        set-text(btn_clicker, 🔥 Кликов: {clicks})
        play-anim(btn_clicker, pulse, 0.2s)
    end-click

    // Авторизация и проверка пароля
    on-click(btn_login)
        chek(val(code_input) == "1234")
            set-text(status_txt, Доступ разрешён! Ядро разблокировано.)
            repaint-color(status_txt, #00ff88)
            show(secret_box)
            clear-val(code_input)
            play-anim(secret_box, slide, 0.4s)
        else
            set-text(status_txt, Ошибка: Неверный ключ доступа!)
            repaint-color(status_txt, #ff3366)
            play-anim(code_input, shake, 0.4s)
        end-chek
    end-click

    // Запись конфигурации в localStorage браузера
    on-click(btn_save)
        save(saved_env, val(drop_env))
        save(saved_ram, val(ram_slider))
        alert(Параметры успешно сохранены в локальное хранилище!)
        play-anim(btn_save, pulse, 0.3s)
    end-click
script-end