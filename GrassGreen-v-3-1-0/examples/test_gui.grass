!GrassGreen!
!interface!

int main() {
    set username = "Разработчик";
    set app_ver = "v3.0.1";

    window {
        title("GrassGreen UI - Test Suite");
        size(520, 560);
        color(#12131a);
        theme("dark");
        glass();

        label "🌿 GrassGreen UI {app_ver}" {
            id(lbl_header);
            window-ob(0, 30);
            size(520, 36);
            middle();
            text-color(#00ffcc);
            font-size(24);
            font-style("Segoe UI");
            shadow();
        }

        label "Привет, {username}! Введи текст ниже:" {
            id(lbl_sub);
            window-ob(0, 80);
            size(520, 30);
            middle();
            text-color(#8e99a8);
            font-size(15);
        }

        enter "Напиши что-нибудь сюда..." {
            id(input_box);
            window-ob(60, 130);
            size(400, 38);
            middle();
            text-color(#ffffff);
            font-size(16);
            radius(8);
            shadow();
        }

        label "[Здесь появится введённый текст]" {
            id(lbl_result);
            window-ob(60, 190);
            size(400, 42);
            middle();
            text-color(#ffcc00);
            button-color(#1a1c26);
            font-size(16);
            radius(8);
            shadow();
            pad(10);
        }

        button "Применить текст" {
            id(btn_apply);
            window-ob(60, 260);
            size(400, 44);
            middle();
            button-color(#162b2e);
            text-color(#00ffcc);
            radius(12);
            pad(5);
            shadow();
            font-size(17);
            click-ob(input_box, lbl_result);
        }

        button "Очистить ввод" {
            id(btn_clear);
            window-ob(60, 320);
            size(400, 40);
            middle();
            button-color(#2a1820);
            text-color(#ff4757);
            radius(10);
            font-size(15);
            shadow();
            clear();
        }

        button "Запустить Блокнот (Run WinExec)" {
            id(btn_run);
            window-ob(60, 380);
            size(400, 40);
            middle();
            button-color(#1e2230);
            text-color(#5352ed);
            radius(10);
            font-size(15);
            shadow();
            run("notepad.exe");
        }

        animate-btn_apply;
        animate-btn_clear;
        show();
    }

    return 0;
}