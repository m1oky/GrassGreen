{
  "GrassGreen Main Template": {
    "prefix": "main",
    "body": [
      "!GrassGreen!",
      "",
      "int main() {",
      "\tgout << \"${1:Hello from GrassGreen 4.0!}\" << endl;",
      "\t${0}",
      "\treturn 0;",
      "}"
    ],
    "description": "Базовый шаблон программы GrassGreen с точкой входа main"
  },
  "Grass Output Stream": {
    "prefix": "gout",
    "body": [
      "gout << \"${1:Message}\" << endl;"
    ],
    "description": "Потоковый вывод в консоль gout << ... << endl;"
  },
  "Grass Input Stream": {
    "prefix": "gin",
    "body": [
      "gin >> ${1:variable};"
    ],
    "description": "Потоковый ввод из консоли gin >> var;"
  },
  "Function Definition": {
    "prefix": "fn",
    "body": [
      "take ${1:function_name}(${2:args}) {",
      "\t${0}",
      "\treturn ${3:0};",
      "}"
    ],
    "description": "Определение функции с возвращаемым значением"
  },
  "Struct Declaration": {
    "prefix": "struct",
    "body": [
      "struct ${1:Point} {",
      "\t${2:x}: ${3:u32},",
      "\t${4:y}: ${5:u32}",
      "}"
    ],
    "description": "Объявление структуры данных C-ABI"
  },
  "Thread Spawn": {
    "prefix": "thread",
    "body": [
      "take ${1:t} = thread(${2:func_name}, ${3:arg1});",
      "take ${4:res} = thread_join(${1:t});"
    ],
    "description": "Запуск функции в системном потоке с ожиданием результата"
  },
  "Async Task": {
    "prefix": "async",
    "body": [
      "async ${1:task_function}(${2:args});"
    ],
    "description": "Запуск асинхронной задачи в фоновом потоке"
  },
  "Mutex Lock Pattern": {
    "prefix": "mutex",
    "body": [
      "take ${1:mtx} = mutex_create();",
      "mutex_lock(${1:mtx});",
      "${0}",
      "mutex_unlock(${1:mtx});",
      "mutex_destroy(${1:mtx});"
    ],
    "description": "Синхронизация потоков через мьютекс"
  },
  "Import Module": {
    "prefix": "import",
    "body": [
      "import \"${1:modules/utils.grass}\";"
    ],
    "description": "Импорт внешнего модуля GrassGreen"
  },
  "While Loop": {
    "prefix": "while",
    "body": [
      "while (${1:condition}) {",
      "\t${0}",
      "}"
    ],
    "description": "Цикл while"
  },
  "For Loop": {
    "prefix": "for",
    "body": [
      "for (take ${1:i} = ${2:0}; ${1:i} < ${3:count}; ${1:i}++) {",
      "\t${0}",
      "}"
    ],
    "description": "Цикл for со счетчиком"
  },
  "If Else": {
    "prefix": "ifelse",
    "body": [
      "if (${1:condition}) {",
      "\t${2}",
      "} else {",
      "\t${0}",
      "}"
    ],
    "description": "Условный оператор if-else"
  },
  "MMIO Read": {
    "prefix": "mmio_read",
    "body": [
      "take ${1:val} = mmio_read32(${2:0xB8000});"
    ],
    "description": "Прямое чтение из физической памяти MMIO (8/16/32/64)"
  },
  "MMIO Write": {
    "prefix": "mmio_write",
    "body": [
      "mmio_write32(${1:0xB8000}, ${2:val});"
    ],
    "description": "Прямая запись в физическую память MMIO (8/16/32/64)"
  },
  "Port I/O In": {
    "prefix": "inb",
    "body": [
      "take ${1:byte_val} = inb(${2:0x3F8});"
    ],
    "description": "Чтение из аппаратного порта x86 (inb/inw/inl)"
  },
  "Port I/O Out": {
    "prefix": "outb",
    "body": [
      "outb(${1:0x3F8}, ${2:byte_val});"
    ],
    "description": "Запись в аппаратный порт x86 (outb/outw/outl)"
  },
  "Memory Barrier": {
    "prefix": "barrier",
    "body": [
      "memory_barrier();"
    ],
    "description": "Аппаратный барьер памяти (mfence)"
  },
  "2D Graphics Loop": {
    "prefix": "gfx_app",
    "body": [
      "!GrassGreen!",
      "!2DGraphics!",
      "",
      "int main() {",
      "\tgfx_init(\"${1:Game Window}\", ${2:800}, ${3:600});",
      "",
      "\twhile (gfx_running()) {",
      "\t\tgfx_clear(\"#0d1117\");",
      "\t\tgfx_text(20, 20, \"GrassGreen 2D Graphics Engine\", 20, \"#00ffcc\");",
      "\t\t${0}",
      "\t}",
      "\treturn 0;",
      "}"
    ],
    "description": "Каркас приложения 2D-графики"
  },
  "VD+ Modern UI Application": {
    "prefix": "ui_app",
    "body": [
      "!GrassGreen!",
      "!interface!",
      "",
      "int main() {",
      "\twindow {",
      "\t\tauto_size_display();",
      "\t\tborder-radius-app(${1:16});",
      "\t\theader(\"${2:emerald}\");",
      "\t\ttitle(\"${3:GrassGreen Application}\");",
      "\t\tsize(${4:800}, ${5:600});",
      "\t\ttheme(\"dark\");",
      "\t\tclock();",
      "",
      "\t\tlabel \"${6:Title}\" {",
      "\t\t\twindow-ob(${7:50}, ${8:50});",
      "\t\t\tsize(400, 36);",
      "\t\t\tmiddle();",
      "\t\t}",
      "",
      "\t\tbutton \"${9:Click Me}\" {",
      "\t\t\twindow-ob(${10:50}, ${11:120});",
      "\t\t\tsize(200, 44);",
      "\t\t\tmiddle();",
      "\t\t}",
      "\t}",
      "\treturn 0;",
      "}"
    ],
    "description": "Полноценный каркас GUI приложения VD+ с адаптивным разрешением, шапкой, часами и скруглением"
  },
  "UI Tab View": {
    "prefix": "ui_tab",
    "body": [
      "\ttab = \"${1:Main}\" {",
      "\t\tlabel \"${2:Вкладка Главная}\" {",
      "\t\t\twindow-ob(50, 60);",
      "\t\t\tsize(300, 32);",
      "\t\t}",
      "\t}",
      "",
      "\tbutton \"${3:Переключить вкладку}\" {",
      "\t\twindow-ob(50, 120);",
      "\t\tsize(220, 40);",
      "\t\tswitch(\"${4:Профиль}\");",
      "\t}"
    ],
    "description": "Вкладка и переключение интерфейса через switch(name)"
  },
  "Audio Play Tone": {
    "prefix": "audio_tone",
    "body": [
      "!audio!",
      "audio_tone(${1:440}, ${2:1000}); // 440 Hz (Note A), 1000 ms"
    ],
    "description": "Генерация чистого звукового тона заданной частоты и длительности"
  },
  "Audio Waveform Synthesizer": {
    "prefix": "audio_synth",
    "body": [
      "!audio!",
      "audio_synth(${1:440}, ${2:800}, ${3:0}); // 0=Sine, 1=Square, 2=Sawtooth, 3=Triangle, 4=Noise"
    ],
    "description": "Синтез полифонической волны с выбором формы сигнала"
  },
  "Audio Play File": {
    "prefix": "audio_play",
    "body": [
      "!audio!",
      "audio_play(\"${1:sounds/notify.wav}\");"
    ],
    "description": "Воспроизведение WAV аудиофайла"
  },
  "Clock Widget": {
    "prefix": "clock",
    "body": [
      "clock();"
    ],
    "description": "Виджет часов реального времени с посекундным автообновлением"
  },
  "Border Radius App": {
    "prefix": "border_radius",
    "body": [
      "border-radius-app(${1:16});"
    ],
    "description": "Скругление углов всего окна приложения"
  },
  "Fullscreen Window": {
    "prefix": "fullscreen",
    "body": [
      "fullscreen();"
    ],
    "description": "Полноэкранный режим окна приложения"
  },
  "Ambient Particles": {
    "prefix": "particles",
    "body": [
      "particles(${1:35}, \"${2:#22c55e}\");"
    ],
    "description": "Анимированные светящиеся частицы на фоне окна"
  },
  "Inline Assembly Block": {
    "prefix": [
      "asm",
      "inline_asm"
    ],
    "body": [
      "asm {",
      "\t${1:cli}",
      "\t${2:sti}",
      "}"
    ],
    "description": "Встроенный ассемблер ядра x86_64 (!asm!)"
  },
  "Kernel Bare-Metal Entry": {
    "prefix": [
      "kernel",
      "baremetal"
    ],
    "body": [
      "!GrassGreen!",
      "!asm!",
      "",
      "int main() {",
      "\tcli();",
      "\tasm {",
      "\t\t${1:xor eax, eax}",
      "\t}",
      "\tsti();",
      "\thlt();",
      "\treturn 0;",
      "}"
    ],
    "description": "Шаблон инициализации ядра операционной системы на голом железе (!asm!)"
  },
  "Keyboard Read Line": {
    "prefix": [
      "kbd_line",
      "read_line",
      "readline"
    ],
    "body": [
      "take ${1:input} = kbd_read_line();"
    ],
    "description": "Построчный ввод с клавиатуры PS/2 с поддержкой Backspace (!keyboard!)"
  },
  "Keyboard Poll Loop": {
    "prefix": [
      "kbd_loop",
      "poll_key"
    ],
    "body": [
      "while (true) {",
      "\tif (kbd_has_key()) {",
      "\t\ttake sc = kbd_get_scancode();",
      "\t\ttake ch = kbd_scancode_to_char(sc);",
      "\t\t${1:// handle key}",
      "\t}",
      "}"
    ],
    "description": "Цикл опроса клавиатуры контроллера PS/2 (!keyboard!)"
  },
  "Multiboot Kernel Complete": {
    "prefix": [
      "kernel_os",
      "os_main"
    ],
    "body": [
      "!GrassGreen!",
      "!asm!",
      "!keyboard!",
      "",
      "int main() {",
      "\tcli();",
      "\tgout << \"[GrassOS v4.2.0]: Kernel Started on Bare-Metal!\" << endl;",
      "\tgout << \"Type a command: \";",
      "\ttake cmd = kbd_read_line();",
      "\tgout << \"Received: \" << cmd << endl;",
      "\tsti();",
      "\thlt();",
      "\treturn 0;",
      "}"
    ],
    "description": "Шаблон полного ядра операционной системы для компиляции через --kernel / --iso (!asm!, !keyboard!)"
  }
}