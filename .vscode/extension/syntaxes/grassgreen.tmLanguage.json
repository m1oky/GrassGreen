{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "GrassGreen",
  "scopeName": "source.grassgreen",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#directives"
    },
    {
      "include": "#imports"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#stream_io"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.grassgreen",
          "match": "//.*$"
        },
        {
          "name": "comment.block.grassgreen",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "name": "keyword.control.directive.grassgreen",
          "match": "!(GrassGreen|hardware|hw|sysinfo|device|2DGraphics|tg|fsys|json|math|FastMath|CoreMath|memory|GrassNet|proc|sys|interface|time|mmio|io|hw|thread|async|rand|audio|GrassWeb|database|asm|GrassASM|assembler|keyboard|kbd|ps2|PS2Keyboard|[a-zA-Z0-9_]+)!"
        }
      ]
    },
    "imports": {
      "patterns": [
        {
          "match": "\\b(import|include|#include)\\b",
          "name": "keyword.control.import.grassgreen"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.grassgreen",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.grassgreen",
              "match": "\\\\(x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|[0-2][0-7]{0,2}|3[0-6][0-7]?|37[0-7]?|[4-7][0-7]?|.|$)"
            }
          ]
        }
      ]
    },
    "stream_io": {
      "patterns": [
        {
          "match": "\\b(gout|gin|cout|cin)\\b",
          "name": "support.class.stream.grassgreen"
        },
        {
          "match": "\\b(endl)\\b",
          "name": "support.constant.stream.grassgreen"
        },
        {
          "match": "(<<|>>)",
          "name": "keyword.operator.stream.grassgreen"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.grassgreen",
          "match": "\\b(if|else|while|for|return|break|continue|switch|tab|use|utf)\\b"
        },
        {
          "name": "storage.modifier.grassgreen",
          "match": "\\b(volatile|static|const)\\b"
        },
        {
          "name": "storage.type.grassgreen",
          "match": "\\b(take|set|struct|array)\\b"
        },
        {
          "name": "keyword.control.concurrency.grassgreen",
          "match": "\\b(thread|async)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.grassgreen",
          "match": "\\b(int|void|string|float|double|u8|u16|u32|u64|bool|char)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.grassgreen",
          "match": "\\b(true|false|null|nil)\\b"
        },
        {
          "name": "constant.numeric.hex.grassgreen",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.binary.grassgreen",
          "match": "\\b0[bB][01]+\\b"
        },
        {
          "name": "constant.numeric.color.grassgreen",
          "match": "#[0-9a-fA-F]{6}\\b|#[0-9a-fA-F]{3}\\b"
        },
        {
          "name": "constant.numeric.float.grassgreen",
          "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.decimal.grassgreen",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.hardware.grassgreen",
          "match": "\\b(hw_ram_total|hw_ram_used|hw_ram_free|proc_mem|hw_ram_cached|hw_ram_speed|hw_ram_temp|hw_ram_model|hw_ram_form|hw_cpu_vendor|hw_cpu_brand|hw_cpu_cores|hw_cpu_threads|hw_cpu_logical|hw_cpu_sockets|hw_cpu_family|hw_cpu_freq|hw_cpu_base_freq|hw_cpu_usage|hw_cpu_temp|hw_cpu_cache_l1|hw_cpu_cache_l2|hw_cpu_cache_l3|hw_cpu_virt|hw_uptime_sec|hw_uptime_str|hw_disk_size|hw_disk_free|hw_disk_format|hw_disk_model|hw_disk_type|hw_disk_temp|hw_disk_read_speed|hw_disk_write_speed|hw_disk_resp_time|hw_disk_usage|hw_disk_active|hw_disk_is_system|hw_pagefile_total|hw_pagefile_used|hw_net_adapter|hw_net_type|hw_net_ipv4|hw_net_ipv6|hw_net_recv_speed|hw_net_send_speed|hw_net_recv_total|hw_net_send_total|hw_gpu_name|hw_gpu_usage|hw_gpu_temp|hw_gpu_vram_total|hw_gpu_vram_used|hw_gpu_vram_shared|hw_board_vendor|hw_board_model|hw_bios_vendor|hw_bios_date|hw_bios_version|hw_pci_count|hw_rdtsc|hw_reboot)\\b"
        },
        {
          "name": "support.function.keyboard.grassgreen",
          "match": "\\b(kbd_has_key|kbd_available|kbd_read_scancode|kbd_get_scancode|kbd_scancode_to_char|kbd_scancode_to_ascii|kbd_getc|kbd_poll|kbd_read_line|kbd_is_shift|kbd_is_caps|kbd_is_ctrl|kbd_is_alt|kbd_is_key_pressed|kbd_scancode_name|kbd_leds|kbd_reset|kbd_self_test|kbd_wait_ack)\\b"
        },
        {
          "name": "support.function.asm.grassgreen",
          "match": "\\b(cli|sti|hlt|in|out|in8|in16|in32|out8|out16|out32|read_cr0|write_cr0|read_cr2|write_cr2|read_cr3|write_cr3|read_cr4|write_cr4|read_rflags|write_rflags|invlpg|rdtsc|pause|nop|cpuid_eax|cpuid_ebx|cpuid_ecx|cpuid_edx|asm_run|asm_bytes|asm_hex|asm_machine_hex|asm)\\b"
        },
        {
          "name": "support.function.thread.grassgreen",
          "match": "\\b(thread_join|thread_detach|thread_id|thread_sleep|mutex_create|mutex_lock|mutex_unlock|mutex_destroy)\\b"
        },
        {
          "name": "support.function.mmio.grassgreen",
          "match": "\\b(mmio_read8|mmio_read16|mmio_read32|mmio_read64|mmio_write8|mmio_write16|mmio_write32|mmio_write64|inb|inw|inl|outb|outw|outl|io_in8|io_in16|io_in32|io_out8|io_out16|io_out32|memory_barrier|read_barrier|write_barrier)\\b"
        },
        {
          "name": "support.function.math.grassgreen",
          "match": "\\b(abs|sqrt|pow|floor|ceil|sin|cos|tan|atan2|deg_to_rad|rad_to_deg|dist2d|lerp|clamp)\\b"
        },
        {
          "name": "support.function.sys.grassgreen",
          "match": "\\b(pc_name|user_name|screen_w|screen_h|cpu_cores|ram_total_mb|ram_free_mb|uptime_sec|clip_set|clip_get)\\b"
        },
        {
          "name": "support.function.time.grassgreen",
          "match": "\\b(get_time_str|get_date|time_ms|start_time|stop_time|conclus_time)\\b"
        },
        {
          "name": "support.function.memory.grassgreen",
          "match": "\\b(memory_free|memory_usit|mem_alloc|mem_free)\\b"
        },
        {
          "name": "support.function.fsys.grassgreen",
          "match": "\\b(fs_write|fs_read|fs_append|fs_exists|fs_delete|fs_mkdir|fs_is_dir|fs_size|fs_list)\\b"
        },
        {
          "name": "support.function.proc.grassgreen",
          "match": "\\b(proc_id|proc_kill|proc_is_alive|proc_ram|proc_list)\\b"
        },
        {
          "name": "support.function.net.grassgreen",
          "match": "\\b(local_ip|resolve_ip|ping|accept)\\b"
        },
        {
          "name": "support.function.json.grassgreen",
          "match": "\\b(json_parse|json_stringify|json_get|json_valid)\\b"
        },
        {
          "name": "support.function.random.grassgreen",
          "match": "\\b(rand_int|rand_float)\\b"
        },
        {
          "name": "support.function.gfx.grassgreen",
          "match": "\\b(gfx_init|gfx_running|gfx_clear|gfx_line|gfx_rect|gfx_circle|gfx_text|gfx_key|gfx_collide)\\b"
        },
        {
          "name": "support.function.ui.grassgreen",
          "match": "\\b(window|title|size|color|theme|glass|label|enter|button|id|window-ob|ob-window|text-color|font-size|font-style|font-family|shadow|radius|middle|center|border-color|bg-color|hover-color|active-color|focus-color|cursor-color|align|placeholder|cursor|text|auto_size_display|border-radius-app|border_radius_app|header|header-color|header_color|header-text-color|header_text_color|clock|tab|switch|surface|fullscreen|fullscrean|z-index|z_index|animation|animate|particles|svg|image|video)\\b"
        },
        {
          "name": "support.function.array.grassgreen",
          "match": "\\b(push|pop|len)\\b"
        },
        {
          "name": "support.function.audio.grassgreen",
          "match": "\\b(audio_play|audio_stop|audio_tone|audio_synth|audio_volume|audio_is_playing|audio_noise|audio_beep|audio)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.grassgreen",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arithmetic.grassgreen",
          "match": "\\+\\+|--|\\+|-|\\*|/|%"
        },
        {
          "name": "keyword.operator.comparison.grassgreen",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.grassgreen",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.assignment.grassgreen",
          "match": "=|\\+=|-=|\\*=|/="
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.grassgreen",
          "match": "[,;:]"
        },
        {
          "name": "punctuation.section.block.grassgreen",
          "match": "[{}]"
        },
        {
          "name": "punctuation.section.parens.grassgreen",
          "match": "[()]"
        },
        {
          "name": "punctuation.section.brackets.grassgreen",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.accessor.grassgreen",
          "match": "\\."
        }
      ]
    }
  }
}