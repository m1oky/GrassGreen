!GrassGreen!
// Repro: Win64 ABI stack argument displacement
// Callee reads caller shadow space at [RBP + 16] instead of stack args at [RBP + 48]
// Arguments 5, 6, 7, 8 receive values of arguments 1, 2, 3, 4

int test_args(int a, int b, int c, int d, int e, int f, int g, int h) {
    gout << a << " " << b << " " << c << " " << d << " " << e << " " << f << " " << g << " " << h << endl;
    return a + b + c + d + e + f + g + h;
}

int main() {
    take res = test_args(10, 20, 30, 40, 50, 60, 70, 80);
    gout << "result = " << res << endl;
    return 0;
}
