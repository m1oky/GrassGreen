<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011">
  <Metadata>
    <Identity Id="GrassGreen.VisualStudio.e58f0c97-6c84-4c55-bbf0-8914b4fcf771" Version="4.3.0" Language="en-US" Publisher="m1oky" />
    <DisplayName>GrassGreen Language Support</DisplayName>
    <Description xml:space="preserve">Full language support for the GrassGreen (G&amp;G) programming language (.grass) in Visual Studio 2022 / 2026: syntax highlighting, real-time error squiggles, and smart IntelliSense completion.</Description>
    <Icon>Resources\icon.png</Icon>
    <PreviewImage>Resources\icon.png</PreviewImage>
    <Tags>GrassGreen;grass;gout;gin;language</Tags>
  </Metadata>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.0, 19.0)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
    <InstallationTarget Id="Microsoft.VisualStudio.Pro" Version="[17.0, 19.0)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
    <InstallationTarget Id="Microsoft.VisualStudio.Enterprise" Version="[17.0, 19.0)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
  </Installation>
  <Dependencies>
    <Dependency Id="Microsoft.Framework.NDP" DisplayName="Microsoft .NET Framework" Version="[4.8,)" />
  </Dependencies>
  <Prerequisites>
    <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor" Version="[17.0, 19.0)" DisplayName="Visual Studio core editor" />
  </Prerequisites>
  <Assets>
    <Asset Type="Microsoft.VisualStudio.MefComponent" Path="GrassGreen.VisualStudio.dll" />
    <Asset Type="Microsoft.VisualStudio.VsPackage" Path="GrassGreenPackage.pkgdef" />
  </Assets>
</PackageManifest>