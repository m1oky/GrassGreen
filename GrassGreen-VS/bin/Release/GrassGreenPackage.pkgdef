[$RootKey$\ContentType\grassgreen]
@="GrassGreen Language"

[$RootKey$\FileExtensionMapping\.grass]
@="grassgreen"

[$RootKey$\FileAssociation\.grass]
@="GrassGreenFile"
"DefaultIcon"="$PackageFolder$\Resources\GrassGreen.ico,0"

[$RootKey$\ShellFolder\.grass]
@="GrassGreen File"

[$RootKey$\Default Icon]
".grass"="$PackageFolder$\Resources\GrassGreen.ico,0"

[$RootKey$\TextMate\Repositories]
"GrassGreen"="$PackageFolder$\Grammars"

[$RootKey$\TextMate\LanguageConfiguration\GrammarMapping]
"source.grass"="$PackageFolder$\Grammars\language-configuration.json"

[$RootKey$\TextMate\LanguageConfiguration\ContentTypeMapping]
"grassgreen"="$PackageFolder$\Grammars\language-configuration.json"
